# Rendered by deploy/install.sh from provision/roles/<role>.conf
[Unit]
Description=Fuel hub counter (@ROLE@, @ALLIANCE@ hub)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/fuelhub/fuelhub.py @SERVE_FLAG@--alliance @ALLIANCE@ --peer @PEER_IP@ --port 502
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=1
User=fuelhub
Group=fuelhub
SupplementaryGroups=gpio

[Install]
WantedBy=multi-user.target
