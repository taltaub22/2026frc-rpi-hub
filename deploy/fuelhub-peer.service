# Peer Pi (blue hub, 10.0.100.41): counts blue hub, sends UDP to the server Pi. No Modbus.
# Install: /etc/systemd/system/fuelhub.service
[Unit]
Description=Fuel hub counter (peer, blue hub)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/fuelhub/fuelhub.py --alliance blue --peer 10.0.100.40
Restart=always
User=fuelhub

[Install]
WantedBy=multi-user.target
