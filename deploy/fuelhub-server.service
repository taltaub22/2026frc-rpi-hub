# Server Pi (red hub, 10.0.100.40): Modbus "PLC" for Cheesy Arena + red hub counting
# Install: /etc/systemd/system/fuelhub.service
[Unit]
Description=Fuel hub counter (Modbus TCP server, red hub)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/fuelhub/fuelhub.py --serve --alliance red --peer 10.0.100.41 --port 502
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
User=fuelhub

[Install]
WantedBy=multi-user.target
